# Telegram user account (Telethon) - для сбора сообщений из каналов, на которые вы подписаны
# Получить на https://my.telegram.org
TELEGRAM_API_ID=12345677
TELEGRAM_API_HASH=123456776493cdc22412345677
TELEGRAM_SESSION=collector_session

# Telegram Bot (создать через @BotFather)
BOT_TOKEN=12344321213:AAHSoS0iEU8RRCA-nbffgr8WxPdTDtAAA

# База данных
DATABASE_PATH=./data/agent.db

# AI backend: ollama или lmstudio
AI_BACKEND=lmstudio

# Ollama (используется, если AI_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# LM Studio (используется, если AI_BACKEND=lmstudio)
# Host без /chat/completions на конце — он добавляется в коде
LMSTUDIO_HOST=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3-8b

# Логи
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log

# Поиск: сколько сообщений максимум передавать в AI за один запрос (бюджет ресурсов)
MAX_MESSAGES_PER_AI_BATCH=40
